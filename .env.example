# Set true only when running the events integration through Netlify Functions.
# Turn appointments remain a local simulation and never book a real visit.
VITE_ENABLE_LIVE_APIS=false

# Server-side secret for Ticketmaster events; keep blank for demo data.
TICKETMASTER_API_KEY=

# Supabase: Project Settings > API Keys
# URL y clave publicable: las usa el front para el login. Pueden quedar expuestas en el navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta: la usan solo las Netlify Functions. Nunca con prefijo VITE_ ni en el repo.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
